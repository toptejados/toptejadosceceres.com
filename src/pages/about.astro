---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.jsx";
import AboutContent from "../components/AboutContent.jsx";
import { formatSiteName } from '../lib/site.js'
import {
  getAnalyticContacts,
  getMenu,
  getAboutPage,
  STRAPI_URL,
} from "../lib/strapi.js";

Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300, stale-while-revalidate=600");

let contactData = null;
let menuData = null;
let apiData = null;

try {
  [contactData, menuData, apiData] = await Promise.all([
    getAnalyticContacts(),
    getMenu(),
    getAboutPage(),
  ]);
} catch (error) {
  console.error("Error fetching about page data:", error);
}

const site = String(
  contactData?.site ?? import.meta.env.PUBLIC_SITE_SLUG ?? "burgos",
);
const phone =
  contactData?.phone ?? import.meta.env.PUBLIC_PHONE ?? "+34 123 456 789";
const email =
  contactData?.email ??
  import.meta.env.PUBLIC_EMAIL ??
  `contacto@tejados${site}.es`;
const waLink = contactData?.waLink;
const socials = contactData?.socials;

const siteName = formatSiteName(site);
const pageTitle = apiData?.metaTitle || `Sobre Nosotros | Top Tejados ${siteName}`;
const ogImageRaw = apiData?.ogImage?.url;
const ogImageUrl = ogImageRaw
  ? (ogImageRaw.startsWith("http") ? ogImageRaw : `${STRAPI_URL}${ogImageRaw}`)
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={apiData?.metaDescription || undefined}
  keywords={apiData?.metaKeywords || undefined}
  canonicalUrl={apiData?.canonicalUrl || undefined}
  ogTitle={apiData?.ogTitle || undefined}
  ogDescription={apiData?.ogDescription || undefined}
  ogImage={ogImageUrl}
  site={site}
  phone={phone}
  email={email}
  jsonLd={apiData?.jsonLd}
>
  <Navbar
    client:load
    site={site}
    phone={phone}
    email={email}
    waLink={waLink}
    socials={socials}
    data={menuData}
  />
  <main>
    <AboutContent client:idle apiData={apiData} strapiUrl={STRAPI_URL} />
  </main>
</BaseLayout>
