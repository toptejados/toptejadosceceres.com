---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.jsx'
import ProjectsContent from '../components/ProjectsContent.jsx'
import { getProjects, getAnalyticContacts, getMenu, STRAPI_URL } from '../lib/strapi.js'
import projectsData from '../data/projects.json'
import { formatSiteName } from '../lib/site.js'

Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300, stale-while-revalidate=600");

let strapiProjects = []
let contactData = null
let menuData = null

try {
  [strapiProjects, contactData, menuData] = await Promise.all([
    getProjects(),
    getAnalyticContacts(),
    getMenu()
  ])
} catch (error) {
  console.error('Error fetching data:', error)
}

let projects = []

if (strapiProjects && strapiProjects.length > 0) {
  projects = strapiProjects.map(p => ({
    id: p.id,
    slug: p.slug,
    category: p.category,
    title: p.title,
    location: p.location,
    date: p.date,
    description: p.description,
    coverImg: p.coverImg?.url ? `${STRAPI_URL}${p.coverImg.url}` : '',
    images: (p.images ?? []).map(img => `${STRAPI_URL}${img.url}`),
  }))
}


const site = String(contactData?.site ?? import.meta.env.PUBLIC_SITE_SLUG ?? 'burgos')
const phone = contactData?.phone ?? import.meta.env.PUBLIC_PHONE ?? '614 005 281'
const email = contactData?.email ?? import.meta.env.PUBLIC_EMAIL ?? `contacto@tejados${site}.es`
const waLink = contactData?.waLink
const socials = contactData?.socials

const siteName = contactData?.businessName ?? `Top Tejados ${formatSiteName(site)}`
const phoneClean = phone.replace(/\s+/g, ' ').trim()

const metaTitle = `Proyectos ${siteName} | Obras Completadas`
const metaDescription = `Descubre los proyectos de ${siteName} en reparación, instalación e impermeabilización con garantía profesional. ☎️Llámanos al ${phoneClean}☎️`
// Relative — BaseLayout resolves it against the real request origin, so no
// env misconfiguration can produce a broken canonical host.
const canonicalUrl = '/proyectos'

const uiData = {
  pageTitle: projectsData.pageTitle,
  detailPage: projectsData.detailPage,
  cta: projectsData.cta,
}
---

<BaseLayout title={metaTitle} description={metaDescription} canonicalUrl={canonicalUrl} ogTitle={metaTitle} ogDescription={metaDescription} site={site} phone={phone} email={email}>
  <Navbar client:load site={site} phone={phone} email={email} waLink={waLink} socials={socials} data={menuData} />
  <main>
    <ProjectsContent client:idle projects={projects} uiData={uiData} site={site} phone={phone} email={email} waLink={waLink} socials={socials} />
  </main>
</BaseLayout>
