---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.jsx'
import BlogContent from '../../components/BlogContent.jsx'
import { getAnalyticContacts, getMenu, getBlogs } from '../../lib/strapi.js'
import { formatSiteName, composeTitle } from '../../lib/site.js'
import { normaliseBlogPosting } from '../../lib/schema.js'
import Breadcrumbs from '../../components/Breadcrumbs.astro'

const { slug } = Astro.params;

Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300, stale-while-revalidate=600");

let contactData = null;
let menuData = null;
let blogsData = [];

try {
  [contactData, menuData, blogsData] = await Promise.all([
    getAnalyticContacts(),
    getMenu(),
    getBlogs(),
  ]);
} catch (error) {
  console.error("Error fetching data:", error);
}

const currentSite = String(
  contactData?.site ?? import.meta.env.PUBLIC_SITE_SLUG ?? "burgos",
).toLowerCase();

const post = blogsData.find(
  (p) =>
    p.slug === slug ||
    p.slug === `${currentSite}-${slug}` ||
    (p.slug || '').replace(`${currentSite}-`, '') === slug
);

if (!post) {
  return Astro.rewrite('/404');
}

const site = currentSite;
const phone = contactData?.phone ?? import.meta.env.PUBLIC_PHONE ?? '+34 123 456 789';
const email = contactData?.email ?? import.meta.env.PUBLIC_EMAIL ?? `contacto@tejados${site}.es`;
const waLink = contactData?.waLink;
const socials = contactData?.socials;

const siteName = formatSiteName(site);
const pageTitle = post.metaTitle || `${post.title} | Blog | Top Tejados ${siteName}`;
const pageDesc = post.metaDescription || post.excerpt || '';
const pageOgTitle = post.ogTitle || undefined;
const pageOgDesc = post.ogDescription || undefined;
// og:image falls back to the post's cover image — almost no post fills the
// dedicated ogImage field, so blog links were sharing as bare text cards and
// twitter:card was degrading to "summary".
const pageOgImage = post.ogImage ?? post.coverImg ?? undefined;
const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: post.title, url: `/blog/${slug}` },
];

// Strapi authors this as an Article whose datePublished is the human string
// shown on the card ("5 de agosto de 2024") — not ISO 8601, so the node fails
// validation and the post is eligible for no date-bearing rich result. Keep
// every authored field, correct the type and the dates.
const postSchema = normaliseBlogPosting(post.jsonLd, post, {
  base: Astro.url.origin,
  canonical: new URL(`/blog/${slug}`, Astro.url.origin).toString(),
  // Deployment slug, not the page's `site` value — the publisher is the
  // province business.
  publisherName: `Top Tejados ${formatSiteName(import.meta.env.PUBLIC_SITE_SLUG || currentSite)}`,
});
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogTitle={pageOgTitle}
  ogDescription={pageOgDesc}
  ogImage={pageOgImage}
  site={site}
  phone={phone}
  email={email}
  canonicalUrl={post.canonicalUrl ?? undefined}
  jsonLd={postSchema}
  breadcrumbs={breadcrumbs}
>
  <Navbar
    client:load
    site={site}
    phone={phone}
    email={email}
    waLink={waLink}
    socials={socials}
    data={menuData}
  />
  <Breadcrumbs items={breadcrumbs} class="border-b border-slate-100 bg-white pt-[72px] md:pt-[88px]" />
  <main>
    <BlogContent client:idle posts={blogsData} initialSlug={slug} />
  </main>
</BaseLayout>
